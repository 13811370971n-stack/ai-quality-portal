[Unit]
Description=AI Quality Portal Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Projects/ai-quality-portal/backend
Environment=PATH=/root/Projects/ai-quality-portal/backend/venv/bin:/usr/bin
ExecStart=/root/Projects/ai-quality-portal/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
