[Unit]
Description=AI Quality Portal Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Projects/ai-quality-portal/frontend
ExecStart=/usr/bin/npx next start -p 3000
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
